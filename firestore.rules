rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // TESTIMONIOS COLLECTION
    // ============================================================
    match /testimonios/{docId} {
      // Public read: only approved testimonials (aprobado == true)
      allow read: if resource.data.aprobado == true;

      // Public create: anyone can submit a new testimonial (will have aprobado == false by default)
      // Required fields: nombre, texto, estrellas (1-5), opcional: anonimo (bool)
      allow create: if request.auth == null
        && request.resource.data.keys().hasAll(['nombre', 'texto', 'estrellas'])
        && request.resource.data.estrellas is int
        && request.resource.data.estrellas >= 1
        && request.resource.data.estrellas <= 5
        && request.resource.data.aprobado == false;

      // Admin full access: the designated admin email via Auth
      allow read, write, delete: if isAdmin();
    }

    // ============================================================
    // BLOG POSTS COLLECTION
    // ============================================================
    match /blogPosts/{docId} {
      // Public read: only published posts
      allow read: if resource.data.publicado == true;

      // Admin full access: create, update, delete, read all (including drafts)
      allow read, write, delete: if isAdmin();

      // Block any non-admin writes
      allow create, update, delete: if false;
    }

    // ============================================================
    // COMENTARIOS DE BLOG COLLECTION
    // ============================================================
    match /blogComments/{docId} {
      // Lectura pública: solo comentarios aprobados para el post específico
      allow read: if resource.data.aprobado == true;

      // Creación pública: cualquiera puede enviar un comentario
      allow create: if request.auth == null
        && request.resource.data.keys().hasAll(['postId', 'texto'])
        && request.resource.data.texto is string
        && request.resource.data.texto.size() >= 5
        && request.resource.data.texto.size() <= 1000
        && (request.resource.data.nombre == null ||
            request.resource.data.nombre is string &&
            request.resource.data.nombre.size() <= 100)
        && (request.resource.data.estrellas == null ||
            (request.resource.data.estrellas is int &&
             request.resource.data.estrellas >= 1 &&
             request.resource.data.estrellas <= 5))
        && request.resource.data.aprobado == false;

      // Acceso total para administradores
      allow read, write, delete: if isAdmin();
    }

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    function isAdmin() {
      return request.auth != null
          && (request.auth.token.email.lower() == 'pensarsentirhacer.pe@gmail.com'
              || request.auth.token.email.lower() == 'paolosotil97@gmail.com');
    }

  }
}